# Example environment for the `web` service
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change_me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://postgres:postgres@postgresql18:5432/dja_badge
ORIGIN_URL_PASS_DETAIL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_LDAP=False
LDAP_AUTH_URL=ldap://your-ldap-server:389
LDAP_AUTH_SEARCH_BASE=dc=example,dc=com
LDAP_AUTH_ACTIVE_DIRECTORY_DOMAIN=example.com
LDAP_AUTH_CONNECTION_USERNAME=cn=admin,dc=example,dc=com
LDAP_AUTH_CONNECTION_PASSWORD=your-ldap-password
LDAP_FILTRO_RESTRIZIONE_UTENTI_AUTENTICABILI=(&(objectClass=person)(memberOf=cn=badge-users,cn=groups,dc=example,dc=com))
